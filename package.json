{
  "name": "carbon.code2cart",
  "description": "Dependencies for Carbon.Code2Chart",
  "license": "UNLICENSED",
  "private": true,
  "browserslist": [
    "defaults",
    "not ie 11",
    "not dead"
  ],
  "dependencies": {
    "highlight.js": "^11.11.1",
    "js2flowchart": "^1.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "postcss": "^8.5.18",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "scripts": {
    "lint": "eslint Resources/Private/Fusion/**/*.js && stylelint Resources/Private/Fusion/**/*.pcss",
